# Copy to .env for local work. `npm run db:start` writes a working .env for you on first run.
# On Railway, set these in the service Variables instead.

# Postgres. On Supabase use the Session pooler connection string for both (see README, section 4.1),
# with ?connection_limit=5 on DATABASE_URL. DIRECT_URL is the one migrations use. Locally both are the same.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/sbm_hr"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/sbm_hr"

# On Railway also set NODE_ENV=production, and do not set PORT (Railway provides it).

# At least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=""

PORT=3000
# Plain HTTP port for the biometric terminals (/iclock only).
ADMS_PORT=8081
# Public address of the app. Used in email links.
APP_URL="http://localhost:5173"

# Email, sent through Resend (resend.com). Create an API key under API Keys and verify your domain
# under Domains. With RESEND_API_KEY empty, development prints emails in the server window.
RESEND_API_KEY=

RESEND_FROM=

# The first admin, created by `npm run seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
